// ACORD Life & Annuities CRM - Prisma Schema
// Generated from ACORD XMLife 2.20.01 XSD files
// 
// This schema maps the core ACORD data structures for:
// - Party management (Persons, Organizations)
// - Holdings (Policies, Annuities)
// - Coverages
// - Relations (linking parties to holdings with roles)
// - CRM-specific extensions (Activities, Notes)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

